# Sleeper League Configuration Template
# Copy this file to .env and fill in your details:
#   cp .env.example .env

LEAGUE_ID=your_sleeper_league_id_here
TEAM_NAME=your_team_name_here

# Timezone & Sync Schedule (Default: Europe/Berlin, every 30 minutes at :00 and :30)
TZ=Europe/Berlin
SYNC_CRON=0,30 * * * *
PORT=8501
